<Window x:Class="GameBoyEmulator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameBoyEmulator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open ROM" Click="OpenROM"></MenuItem>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Palettes">
                    <MenuItem x:Name="LCD1" Header="LCD 1" Click="ChangePalette" IsChecked="True"></MenuItem>
                    <MenuItem x:Name="LCD2" Header="LCD 2" Click="ChangePalette"></MenuItem>
                    <MenuItem x:Name="LCD3" Header="LCD 3" Click="ChangePalette"></MenuItem>
                    <MenuItem x:Name="BaW" Header="Black and White" Click="ChangePalette"></MenuItem>
                </MenuItem>
            </MenuItem>
        </Menu>
        <Grid Background="Black">
            <Image x:Name="Screen" HorizontalAlignment="Center" Height="144" Margin="0,0,0,0" VerticalAlignment="Center" Width="160" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform">
            </Image>

        </Grid>
    </DockPanel>
</Window>
