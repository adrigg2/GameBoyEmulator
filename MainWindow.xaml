<Window x:Class="GameBoyEmulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameBoyEmulator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        ContentRendered="Tick"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">
    <Grid Background="Black">
        <Image x:Name="Screen" HorizontalAlignment="Center" Height="144" Margin="0,0,0,0" VerticalAlignment="Center" Width="160" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform">
        </Image>

    </Grid>
</Window>
